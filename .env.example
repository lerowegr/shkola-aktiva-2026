# Пример настроек. Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env в репозиторий не попадает — там лежат пароли.

# --- База данных ---------------------------------------------------------
# Локально: пользователь вашей системы, базы создаются так (русская сортировка):
#   createdb --locale-provider=icu --icu-locale=ru-RU --template=template0 sha_dev
#   createdb --locale-provider=icu --icu-locale=ru-RU --template=template0 sha_test
# Тесты берут этот же адрес и подменяют имя базы на sha_test.
DATABASE_URL="postgresql://user@localhost:5432/sha_dev?schema=public"

# --- Сессии и коды -------------------------------------------------------
# Секрет для хешей одноразовых кодов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# На сервере ОБЯЗАТЕЛЬНО свой.
AUTH_SECRET="замените-на-свой-секрет"

# Адрес сайта. Локально http://localhost:3000, на проде https://ваш-домен.
# От него зависит имя куки сессии и проверка, откуда пришёл запрос.
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Почта первого тех.админа. Сид делает его владельцем системы.
OWNER_EMAIL=""

# --- Telegram-бот (папка bot/, запуск: npm run bot) ------------------------
# Бота завести через @BotFather (/newbot), токен — сюда.
TELEGRAM_BOT_TOKEN=""
# Username бота без собачки — для кнопки «Войти через Telegram».
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# --- Почта ---------------------------------------------------------------
# Пусто — письма с кодами печатаются в консоль сервера (для разработки).
SMTP_URL=""
MAIL_FROM="Школа Актива <no-reply@example.com>"

# --- Пуши PWA ------------------------------------------------------------
# Пара ключей, которой сервер подписывает пуши. Сгенерировать:
#   npx web-push generate-vapid-keys
# Пусто — пуши выключены. На сервере — своя пара, не локальная.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@ваш-домен"
