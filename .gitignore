# зависимости
/node_modules

# nuxt: всё это генерируется на каждом запуске
/.nuxt/
/.output/
/dist/

# тесты
/coverage
/test-results
/playwright-report

# сгенерированный клиент Prisma — собирается из схемы, в репозитории не нужен
/lib/generated

# настройки с паролями и токенами
.env*
!.env.example
/.preview-accounts.txt

# загруженные пользователями файлы
/uploads

# мусор
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*

# снимок сервера перед деплоем (адреса, порты)
/deploy/server-info.txt
/.preview-accounts.server.txt

# рабочие таблицы организаторов
*.xlsx
/.owner-password.txt

# нагрузочный стенд: токены тестовых сессий
/tools/loadtest/tokens-*.json
