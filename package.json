{
  "name": "sha-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "sh -c 'prisma migrate dev \"$@\" && prisma generate && npm run db:test-sync' --",
    "db:test-sync": "tsx --env-file-if-exists=.env scripts/test-db-sync.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:demo": "tsx --env-file-if-exists=.env scripts/demo-applications.ts",
    "user:password": "tsx --env-file-if-exists=.env scripts/set-password.ts",
    "share": "bash scripts/share.sh",
    "bot": "tsx --env-file-if-exists=.env bot/main.ts"
  },
