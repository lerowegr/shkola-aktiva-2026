# Настройки сайта на сервере: /root/sha-site/.env.production (chmod 600).
# В репозиторий не попадает. Секреты генерируются на сервере, не копируются
# с ноутбука:
#   openssl rand -base64 32                 — AUTH_SECRET
#   openssl rand -hex 24                    — пароль базы
#   docker run --rm node:24-slim npx -y web-push generate-vapid-keys — ключи пушей

# --- База (compose создаёт её с этим паролем при первом запуске) ---------
POSTGRES_PASSWORD="…"
DATABASE_URL="postgresql://sha:…тот-же-пароль…@db:5432/sha?schema=public"

# --- Сайт ------------------------------------------------------------------
AUTH_SECRET="…"
# Пока нет домена — адрес туннеля, его прописывает deploy/quick-tunnel.sh.
NUXT_PUBLIC_APP_URL="https://….trycloudflare.com"
# Временный туннель Cloudflare. С доменом — убрать строку и пересоздать сайт.
TUNNEL=quick
# Порт на loopback сервера (3000 занят порталом СНиМК).
APP_PORT=3110

# Почта первого тех.админа — сид делает его владельцем.
OWNER_EMAIL="…"

# --- Пуши --------------------------------------------------------------------
NUXT_PUBLIC_VAPID_PUBLIC_KEY="…"
VAPID_PRIVATE_KEY="…"
VAPID_SUBJECT="mailto:…"

# --- Потом -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
SMTP_URL=""
MAIL_FROM="Школа Актива <no-reply@…>"

# Сколько дней хранить ночные копии.
BACKUP_KEEP_DAYS=14
